#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Geometry"
    {
        def "Pallet" (
            prepend references = @./pallet.usda@
        )
        {
        }

        def "Box" (
            prepend references = @./box.usda@
        )
        {
            float3 xformOp:scale = (50, 50, 50)
            double3 xformOp:translate = (0, 25.75, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

