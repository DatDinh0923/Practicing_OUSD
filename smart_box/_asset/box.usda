#usda 1.0
(
    defaultPrim = "Box"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Box" (
    prepend payload = @./box_payload.usda@
    prepend specializes = </_Base_Prop>
    variants = {
        string box_status = "intact"
    }
    prepend variantSets = "box_status"
)
{
    variantSet "box_status" = {
        "damaged" {
            over "Box_001"
            {
                color3f[] primvars:displayColor = [(0.7, 0.3, 0.1)]
                float3 xformOp:scale = (1, 0.7, 1)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }

        }
        "intact" {

        }
    }
}

class "_Base_Prop"
{
}

