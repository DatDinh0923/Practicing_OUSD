#usda 1.0
(
    defaultPrim = "Rack"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Rack" (
    prepend specializes = </_Base_Prop>
    variants = {
        string material = "steel"
        string size = "small"
    }
    prepend variantSets = ["size", "material"]
)
{
    def Scope "Prototypes"
    {
        token visibility = "invisible"

        def Xform "BeamHandle"
        {
            def Cube "Beam"
            {
                color3f[] primvars:displayColor
                float3 xformOp:scale
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        def Xform "ShelfHandle"
        {
            def Cube "Shelf"
            {
                color3f[] primvars:displayColor = [(0.6, 0.4, 0.2)]
                float3 xformOp:scale = (1.3, 0.1, 1.95)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
    }

    def Xform "Leg_01" (
        instanceable = true
        prepend references = </Rack/Prototypes/BeamHandle>
    )
    {
        double3 xformOp:translate = (-1, 0, 2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Leg_02" (
        instanceable = true
        prepend references = </Rack/Prototypes/BeamHandle>
    )
    {
        double3 xformOp:translate = (1, 0, 2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Leg_03" (
        instanceable = true
        prepend references = </Rack/Prototypes/BeamHandle>
    )
    {
        double3 xformOp:translate = (-1, 0, -2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Leg_04" (
        instanceable = true
        prepend references = </Rack/Prototypes/BeamHandle>
    )
    {
        double3 xformOp:translate = (1, 0, -2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Shelf_01" (
        instanceable = true
        prepend references = </Rack/Prototypes/ShelfHandle>
    )
    {
        double3 xformOp:translate
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Shelf_02" (
        instanceable = true
        prepend references = </Rack/Prototypes/ShelfHandle>
    )
    {
        double3 xformOp:translate
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    variantSet "size" = {
        "small" {
            over "Prototypes"
            {
                over "BeamHandle"
                {
                    over "Beam"
                    {
                        float3 xformOp:scale = (0.1, 2, 0.1)
                    }
                }
            }

            over "Shelf_01"
            {
                double3 xformOp:translate = (0, -0.2, 0)
            }

            over "Shelf_02"
            {
                double3 xformOp:translate = (0, 1.8, 0)
            }

        }
        "tall" {
            over "Prototypes"
            {
                over "BeamHandle"
                {
                    over "Beam"
                    {
                        float3 xformOp:scale = (0.1, 5, 0.1)
                    }
                }
            }

            over "Shelf_01"
            {
                double3 xformOp:translate = (0, -0.2, 0)
            }

            over "Shelf_02"
            {
                double3 xformOp:translate = (0, 4.8, 0)
            }

        }
    }
    variantSet "material" = {
        "steel" {
            over "Prototypes"
            {
                over "BeamHandle"
                {
                    over "Beam"
                    {
                        color3f[] primvars:displayColor = [(0.4, 0.45, 0.45)]
                    }
                }
            }

        }
        "wood" {
            over "Prototypes"
            {
                over "BeamHandle"
                {
                    over "Beam"
                    {
                        color3f[] primvars:displayColor = [(0.7, 0.25, 0.05)]
                    }
                }
            }

        }
    }
}

class "_Base_Prop"
{
}

